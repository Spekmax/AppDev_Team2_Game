<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.85"
        android:scaleType="centerCrop"
        android:src="@drawable/jungle_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/boardContainer"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/geckoSelector"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/boardGrid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:columnCount="10"
            android:rowCount="10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    // logout button
    <Button
        android:id="@+id/logoutButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:backgroundTint="#AA0000"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/geckoSelector"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/geckoSelector"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="#66000000"
        app:layout_constraintBottom_toTopOf="@id/actionBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/gecko2"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/gecko_2"
            android:alpha="0.5"/>

        <ImageView
            android:id="@+id/gecko3"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/gecko_3"
            android:alpha="0.5"
            android:layout_marginStart="20dp"/>

        <ImageView
            android:id="@+id/gecko4"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/gecko_4"
            android:alpha="0.5"
            android:layout_marginStart="20dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#55000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnRotate"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@android:color/transparent"
            android:adjustViewBounds="true"
            android:scaleType="centerInside"
            android:padding="0dp"
            android:src="@drawable/rotate_button"
            android:contentDescription="Rotate gecko" />

        <ImageButton
            android:id="@+id/btnConfirm"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="20dp"
            android:background="@android:color/transparent"
            android:adjustViewBounds="true"
            android:scaleType="centerInside"
            android:padding="0dp"
            android:src="@drawable/confirm_button"
            android:contentDescription="Confirm placement" />

        <ImageButton
            android:id="@+id/btnAttack"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="20dp"
            android:background="@android:color/transparent"
            android:adjustViewBounds="true"
            android:scaleType="centerInside"
            android:padding="0dp"
            android:src="@drawable/attack_button"
            android:contentDescription="Attack" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>